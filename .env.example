# Copy to .env (backend folder). No secrets are needed: everything runs locally.
APP_NAME=StudyMate AI
DEBUG=false
FRONTEND_ORIGIN=http://localhost:5173

# Local AI (Ollama)
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=240
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=5m

# Embeddings (sentence-transformers). "hash" is only for automated tests.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document processing
CHUNK_SIZE=700
CHUNK_OVERLAP=100
MAX_UPLOAD_MB=20

# Retrieval
TOP_K=4
RELEVANCE_THRESHOLD=0.25
HISTORY_MESSAGES=6
MAX_CONTEXT_CHARS=3000
